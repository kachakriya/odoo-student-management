<odoo>

<!--Create Form View Include all fields:Use <group> for layout-->
    <record id="view_student_basic_form" model="ir.ui.view">
        <field name="name">student</field>
        <field name="model">student.basic</field>
        <field name="arch" type="xml">
            <form>
                <sheet>

                    <group string="Basic Info">
                        <field name="name"/>
                        <field name="age"/>
                        <field name="gender"/>
                        <field name="expiration_date"/>
                    </group>

                    <group string="Contact">
                        <field name="email"/>
                        <field name="phone"/>

                    </group>

                    <group string="Other">
                        <field name="active"/>
                        <field name="description"/>
                    </group>

                </sheet>
            </form>
        </field>
    </record>

    <!--Create list View Show only:Name,Age,Email-->
    <record id="view_student_basic_list" model="ir.ui.view">
        <field name="name">student</field>
        <field name="model">student.basic</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="age"/>
                <field name="email"/>
            </list>
        </field>
    </record>

<!-- Create Action Open list + form view-->
    <record id="action_student_basic" model="ir.actions.act_window">
        <field name="name">Students</field>
        <field name="res_model">student.basic</field>
        <field name="view_mode">list,form</field>
    </record>

<!-- Create Menu Student Basic -> Students-->
    <menuitem id="student_basic_main"
              name="Student Basic"/>

    <menuitem id="student_basic_student"
              name="Students"
              parent="student_basic_main"
              action="action_student_basic"/>

</odoo>